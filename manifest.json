{
    "manifest_version": 3,
    "name": "PhishEye",
    "version": "1.0",
    "description": "This is exentsion is an ai integrated phishing detection and threat assment utility.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "PhishEye",
        "default_popup": "popup.html"
    },
    "permissions": ["activeTab"],
    "content_scripts": [
        {
            "matches": ["https://*/*", "http://*/*"],
            "js": ["brands.js", "content.js"]
        }
    ]
}